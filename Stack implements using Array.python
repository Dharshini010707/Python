class Stack:    

    def __init__(self):
        self.stack = []
       
    def push(self,item):
        self.stack.append(item)
        print(f"{item} pushed to stack")
    def pop(self):
        if self.is_empty():
            return "Stack Underflow"
        return self.stack.pop()
    def peek(self):
        if self.is_empty():
            return "Stack is empty"
        return self.stack[-1]
    def is_empty(self):
        return len(self.stack) == 0
    def size(self):
        return len(self.stack)
    def display(self):
        print("Stack elements:", self.stack)

b=Stack()
b.push("Harry Potter")
b.push("Percy Jackson")
b.push("2 States")


print("1.Push")
print("2.Pop")
print("3.Peek")
choice= int(input("Enter the choice"))
if choice==1:
    a=input("Enter a book title to push:")
    b.push(a)
elif choice==2:
    removed_element=Stack.pop
    if removed_element=="stack underflow":
        print(removed_element)
    else:
        print("Popped:",b.pop())
elif choice==3:
    print("The top book is ",b.peek())
b.display()
